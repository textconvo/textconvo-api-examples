# TextConvo API examples — sample environment
#
# Copy to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# Get keys from your TextConvo account: https://textconvo.ai/contact-us

# --- Required --------------------------------------------------------------

# Your API key.
TEXTCONVO_API_KEY=YOUR_API_KEY

# Identifies which lead source the request belongs to.
TEXTCONVO_SOURCE_KEY=YOUR_SOURCE_KEY

# --- Optional --------------------------------------------------------------

# API base URL. Only change this if TextConvo support asks you to.
TEXTCONVO_BASE_URL=https://api.textconvo.ai

# Shared secret for HMAC request signing. Leave empty unless signing is
# enabled for your source. See https://textconvo.ai/docs#hmac-authentication
TEXTCONVO_HMAC_SECRET=

# Secret used to verify inbound webhook signatures in the receiver examples.
# See https://textconvo.ai/docs#webhooks
TEXTCONVO_WEBHOOK_SECRET=

# --- Example test data -----------------------------------------------------
# Use a phone number you own. Never test against a real customer.
TEST_PHONE=+15035551234
TEST_EMAIL=jane.doe@example.com
